<Project Sdk="Microsoft.NET.Sdk">

  <!-- Legacy MSTest v1 tests, linked unchanged and run against the ported libraries on net10.0.
       MSTest 3.x keeps [ExpectedException] (removed in 4.x), which several legacy tests use.
       Test folders are added as the projects they depend on get ported. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <LegacyTestsDir>..\..\..\HeuristicLab.Tests\</LegacyTestsDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="AssertionsAsExceptions.cs" />
    <Compile Include="AtticRoundTripTest.cs" />
    <Compile Include="RuntimeCompilationTest.cs" />
    <Compile Include="$(LegacyTestsDir)HeuristicLab.Collections-3.3\**\*.cs" LinkBase="Legacy\HeuristicLab.Collections-3.3" />
    <Compile Include="$(LegacyTestsDir)HeuristicLab.Common-3.3\**\*.cs" LinkBase="Legacy\HeuristicLab.Common-3.3" />
    <Compile Include="$(LegacyTestsDir)HeuristicLab.Random-3.3\**\*.cs" LinkBase="Legacy\HeuristicLab.Random-3.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\core\HeuristicLab.Collections\HeuristicLab.Collections.csproj" />
    <ProjectReference Include="..\..\core\HeuristicLab.Common\HeuristicLab.Common.csproj" />
    <ProjectReference Include="..\..\core\HeuristicLab.Core\HeuristicLab.Core.csproj" />
    <ProjectReference Include="..\..\core\HeuristicLab.Data\HeuristicLab.Data.csproj" />
    <ProjectReference Include="..\..\core\HeuristicLab.Operators.Programmable\HeuristicLab.Operators.Programmable.csproj" />
    <ProjectReference Include="..\..\core\HeuristicLab.Random\HeuristicLab.Random.csproj" />
    <ProjectReference Include="..\..\core\HeuristicLab.Scripting\HeuristicLab.Scripting.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MSTest" Version="3.11.1" />
  </ItemGroup>

</Project>
