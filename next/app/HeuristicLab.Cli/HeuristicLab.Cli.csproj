<Project Sdk="Microsoft.NET.Sdk">

  <!-- "hl": command-line front end on HeuristicLab.Next.Runtime (batch runs, reports, scripting). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>hl</AssemblyName>
    <RootNamespace>HeuristicLab.Cli</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\runtime\HeuristicLab.Next.Runtime\HeuristicLab.Next.Runtime.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.12" />
  </ItemGroup>

</Project>
