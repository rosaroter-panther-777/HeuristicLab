<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:HeuristicLab.Studio.ViewModels"
        xmlns:controls="using:HeuristicLab.Studio.Controls"
        xmlns:runtime="using:HeuristicLab.Next.Runtime"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
        x:Class="HeuristicLab.Studio.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Width="1100" Height="700" MinWidth="720" MinHeight="460"
        Title="{Binding Title}">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <DockPanel>
        <!-- toolbar -->
        <Border DockPanel.Dock="Top" Padding="10,8" BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="New..." Command="{Binding NewCommand}" />
                <Button Content="Open..." Command="{Binding OpenCommand}" />
                <Button Content="Save as..." Command="{Binding SaveCommand}" />
                <Separator Width="1" Margin="4,2" />
                <TextBlock Text="Seed" VerticalAlignment="Center" />
                <TextBox Text="{Binding SeedText}" Width="90" PlaceholderText="random" />
                <TextBlock Text="Runs" VerticalAlignment="Center" />
                <TextBox Text="{Binding RepetitionsText}" Width="50" />
                <TextBlock Text="Parallel" VerticalAlignment="Center" />
                <TextBox Text="{Binding ParallelText}" Width="50" />
                <Button Content="Run" Command="{Binding RunCommand}" Classes="accent" />
                <Button Content="Stop" Command="{Binding RunCancelCommand}" />
                <Separator Width="1" Margin="4,2" />
                <Button Content="Results folder..." Command="{Binding ChooseResultsFolderCommand}" />
                <TextBlock Text="{Binding ResultsFolder}" VerticalAlignment="Center" Opacity="0.7" MaxWidth="260" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Border>

        <!-- status bar -->
        <Border DockPanel.Dock="Bottom" Padding="10,4" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
            <TextBlock Text="{Binding Status}" />
        </Border>

        <TabControl Padding="0">
            <TabItem Header="Run">
                <Grid ColumnDefinitions="340,4,*" Margin="0">
                    <!-- document and parameters -->
                    <DockPanel Grid.Column="0" Margin="12">
                        <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,10">
                            <TextBlock Text="{Binding DocumentName}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding DocumentDetails}" TextWrapping="Wrap" Opacity="0.75" />
                        </StackPanel>
                        <Expander DockPanel.Dock="Bottom" Header="Sweep / walk-forward" Margin="0,10,0,0" HorizontalAlignment="Stretch">
                    <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="6">
                        <TextBlock Text="Sweep" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Text="{Binding SweepText}" TextWrapping="Wrap"
                                 PlaceholderText="PopulationSize=50,200; Selector=TournamentSelector,ProportionalSelector" />
                        <TextBlock Grid.Row="1" Text="Walk-forward" VerticalAlignment="Center" />
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="6">
                            <TextBox Text="{Binding WalkTrainText}" Width="64" PlaceholderText="train" />
                            <TextBox Text="{Binding WalkTestText}" Width="64" PlaceholderText="test" />
                            <TextBox Text="{Binding WalkStepText}" Width="64" PlaceholderText="step" />
                        </StackPanel>
                        <CheckBox Grid.Row="2" Grid.Column="1" Content="Expanding training window" IsChecked="{Binding WalkExpanding}" />
                        <TextBlock Grid.Row="3" Grid.ColumnSpan="2" TextWrapping="Wrap" Opacity="0.7" FontSize="12"
                                   Text="Run uses walk-forward if training rows are set, else the sweep (each configuration with Runs seeds), else single or repeated runs." />
                    </Grid>
                </Expander>
                <TextBlock DockPanel.Dock="Top" Text="Parameters" FontWeight="SemiBold" Margin="0,4,0,4" />
                        <ScrollViewer>
                            <ItemsControl ItemsSource="{Binding Parameters}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ParameterRowViewModel">
                                        <Grid ColumnDefinitions="150,*" Margin="0,1" ToolTip.Tip="{Binding Description}">
                                            <TextBlock Text="{Binding Name}" Opacity="0.75" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            <TextBox Grid.Column="1" Text="{Binding Value, UpdateSourceTrigger=LostFocus}" IsVisible="{Binding IsText}"
                                                     IsReadOnly="{Binding !Editable}" MinHeight="26" Padding="6,2" />
                                            <ComboBox Grid.Column="1" ItemsSource="{Binding Choices}" SelectedItem="{Binding Value}" IsVisible="{Binding IsChoice}"
                                                      HorizontalAlignment="Stretch" MinHeight="26" Padding="6,2" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>

                    <GridSplitter Grid.Column="1" ResizeDirection="Columns"
                                  Background="{DynamicResource SystemControlForegroundBaseLowBrush}" />

                    <!-- progress chart and results -->
                    <Grid Grid.Column="2" RowDefinitions="*,Auto,220" Margin="12">
                        <controls:LineChart Grid.Row="0" Series="{Binding Series}" XAxisTitle="{Binding ChartXAxisTitle}"
                                            Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                        <TextBlock Grid.Row="1" Text="Results" FontWeight="SemiBold" Margin="0,10,0,4" />
                        <ScrollViewer Grid.Row="2">
                            <ItemsControl ItemsSource="{Binding Results}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:NameValue">
                                        <Grid ColumnDefinitions="260,*" Margin="0,2">
                                            <TextBlock Text="{Binding Name}" Opacity="0.75" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Text="{Binding Value}" FontFamily="monospace" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="Solution">
                <Grid Margin="12" RowDefinitions="Auto,Auto,Auto,*" ColumnDefinitions="*,320" DataContext="{Binding Solution}" x:DataType="vm:SolutionViewModel">
                    <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                        <TextBlock Text="Solution" VerticalAlignment="Center" />
                        <ComboBox ItemsSource="{Binding Solutions}" SelectedItem="{Binding Selected}" MinWidth="320"
                                  DisplayMemberBinding="{Binding Name, x:DataType=runtime:SolutionView}" />
                    </StackPanel>
                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Heading}" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBox Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding Model}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="90"
                             FontFamily="monospace" Margin="0,0,0,8" IsVisible="{Binding Model, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <controls:LineChart Grid.Row="3" Series="{Binding Series}" Markers="{Binding Markers}"
                                        XAxisTitle="{Binding XAxisTitle}" YAxisTitle="{Binding YAxisTitle}"
                                        Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                    <ScrollViewer Grid.Row="3" Grid.Column="1" Margin="12,0,0,0">
                        <ItemsControl ItemsSource="{Binding Metrics}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:NameValue">
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                        <TextBlock Text="{Binding Name}" Opacity="0.75" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{Binding Value}" FontFamily="monospace" Margin="8,0,0,0" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>
            <TabItem Header="Results">
                <DockPanel Margin="12" DataContext="{Binding ResultsBrowser}" x:DataType="vm:ResultsBrowserViewModel">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
                        <Button Content="Open results folder..." Command="{Binding OpenFolderCommand}" />
                        <Button Content="Reload" Command="{Binding ReloadCommand}" />
                        <TextBlock Text="Result" VerticalAlignment="Center" Margin="12,0,0,0" />
                        <ComboBox ItemsSource="{Binding Metrics}" SelectedItem="{Binding Metric}" MinWidth="200" />
                        <TextBlock Text="Group by" VerticalAlignment="Center" />
                        <ComboBox ItemsSource="{Binding GroupColumns}" SelectedItem="{Binding GroupBy}" MinWidth="200" />
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding Status}" Opacity="0.75" Margin="0,0,0,8" />
                    <TextBlock DockPanel.Dock="Top" Text="Statistics per group (completed runs)" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="2*,50,*,*,*,*,*" Margin="0,0,0,2">
                        <TextBlock Text="group" Opacity="0.6" /><TextBlock Grid.Column="1" Text="n" Opacity="0.6" />
                        <TextBlock Grid.Column="2" Text="mean" Opacity="0.6" /><TextBlock Grid.Column="3" Text="sd" Opacity="0.6" />
                        <TextBlock Grid.Column="4" Text="min" Opacity="0.6" /><TextBlock Grid.Column="5" Text="median" Opacity="0.6" />
                        <TextBlock Grid.Column="6" Text="max" Opacity="0.6" />
                    </Grid>
                    <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Summary}" Margin="0,0,0,14">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SummaryRow">
                                <Grid ColumnDefinitions="2*,50,*,*,*,*,*" Margin="0,1">
                                    <TextBlock Text="{Binding Group}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{Binding Count}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Mean}" FontFamily="monospace" />
                                    <TextBlock Grid.Column="3" Text="{Binding StdDev}" FontFamily="monospace" />
                                    <TextBlock Grid.Column="4" Text="{Binding Min}" FontFamily="monospace" />
                                    <TextBlock Grid.Column="5" Text="{Binding Median}" FontFamily="monospace" />
                                    <TextBlock Grid.Column="6" Text="{Binding Max}" FontFamily="monospace" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock DockPanel.Dock="Top" Text="Runs" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="170,2*,100,100,*" Margin="0,0,0,2">
                        <TextBlock Text="started (UTC)" Opacity="0.6" /><TextBlock Grid.Column="1" Text="optimizer" Opacity="0.6" />
                        <TextBlock Grid.Column="2" Text="seed" Opacity="0.6" /><TextBlock Grid.Column="3" Text="outcome" Opacity="0.6" />
                        <TextBlock Grid.Column="4" Text="result" Opacity="0.6" />
                    </Grid>
                    <ScrollViewer>
                        <ItemsControl ItemsSource="{Binding Runs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:RunRow">
                                    <Grid ColumnDefinitions="170,2*,100,100,*" Margin="0,1">
                                        <TextBlock Text="{Binding Started}" FontFamily="monospace" />
                                        <TextBlock Grid.Column="1" Text="{Binding Optimizer}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2" Text="{Binding Seed}" />
                                        <TextBlock Grid.Column="3" Text="{Binding Outcome}" />
                                        <TextBlock Grid.Column="4" Text="{Binding Metric}" FontFamily="monospace" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
