<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HeuristicLab.Studio.ViewModels"
             x:Class="HeuristicLab.Studio.Views.OperatorGraphView"
             x:DataType="vm:OperatorGraphViewModel">
    <UserControl.Styles>
        <Style Selector="ItemsControl.canvas > ContentPresenter" x:DataType="vm:GraphNodeView">
            <Setter Property="Canvas.Left" Value="{Binding X}" />
            <Setter Property="Canvas.Top" Value="{Binding Y}" />
        </Style>
        <Style Selector="ItemsControl.labels > ContentPresenter" x:DataType="vm:GraphEdgeView">
            <Setter Property="Canvas.Left" Value="{Binding LabelX}" />
            <Setter Property="Canvas.Top" Value="{Binding LabelY}" />
        </Style>
        <Style Selector="Border.node">
            <Setter Property="Background" Value="#DCEBDD" />
            <Setter Property="BorderBrush" Value="#6F9F72" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="TextElement.Foreground" Value="#1E2A1F" />
        </Style>
        <Style Selector="Border.node.initial">
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="Border.node.selected">
            <Setter Property="BorderBrush" Value="#2E7D32" />
            <Setter Property="BorderThickness" Value="3" />
        </Style>
    </UserControl.Styles>
    <Grid RowDefinitions="Auto,3*,4,2*">
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,6">
            <Button Content="Back" Command="{Binding BackCommand}" IsEnabled="{Binding CanGoBack}" />
            <Button Content="Open operator graph" Command="{Binding OpenCommand}"
                    ToolTip.Tip="Show the graph inside the selected operator (e.g. the main loop); double-click works too" />
            <TextBlock Text="Zoom" VerticalAlignment="Center" Margin="8,0,0,0" />
            <Slider Minimum="0.4" Maximum="1.6" Value="{Binding Zoom}" Width="120" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Title}" VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <Border Grid.Row="1" BorderThickness="1" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" MinHeight="200">
            <ScrollViewer HorizontalScrollBarVisibility="Auto">
                <LayoutTransformControl>
                    <LayoutTransformControl.LayoutTransform>
                        <ScaleTransform ScaleX="{Binding Zoom}" ScaleY="{Binding Zoom}" />
                    </LayoutTransformControl.LayoutTransform>
                    <Panel Width="{Binding Width}" Height="{Binding Height}" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <ItemsControl ItemsSource="{Binding Edges}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:GraphEdgeView">
                                    <Line StartPoint="{Binding Start}" EndPoint="{Binding End}" Stroke="#8A8A8A" StrokeThickness="1.5" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl Classes="labels" ItemsSource="{Binding Edges}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:GraphEdgeView">
                                    <TextBlock Text="{Binding Label}" FontSize="10" Opacity="0.6" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl Classes="canvas" ItemsSource="{Binding Nodes}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:GraphNodeView">
                                    <Border Classes="node" Classes.initial="{Binding IsInitial}" Width="190" Height="44" Padding="8,3"
                                            Tapped="NodeTapped" DoubleTapped="NodeDoubleTapped" ToolTip.Tip="{Binding Kind}">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Kind}" FontSize="10" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Panel>
                </LayoutTransformControl>
            </ScrollViewer>
        </Border>
        <GridSplitter Grid.Row="2" ResizeDirection="Rows" Background="{DynamicResource SystemControlForegroundBaseLowBrush}" />
        <ScrollViewer Grid.Row="3" Margin="0,8,0,0">
            <ContentControl Content="{Binding SelectedEditor}" />
        </ScrollViewer>
    </Grid>
</UserControl>
