<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:HeuristicLab.Studio.ViewModels"
        x:Class="HeuristicLab.Studio.Views.NewSetupWindow"
        x:DataType="vm:NewSetupViewModel"
        Title="New" Width="620" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="16" Spacing="10">
        <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
            <TextBlock Text="Algorithm" VerticalAlignment="Center" />
            <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding Algorithms}"
                      SelectedItem="{Binding SelectedAlgorithm}" DisplayMemberBinding="{Binding Display, x:DataType=vm:Choice}" />
            <TextBlock Grid.Row="1" Text="Problem" VerticalAlignment="Center" />
            <ComboBox Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding Problems}"
                      SelectedItem="{Binding SelectedProblem}" DisplayMemberBinding="{Binding Display, x:DataType=vm:Choice}" />
            <TextBlock Grid.Row="2" Text="Benchmark instance" VerticalAlignment="Center" />
            <ComboBox Grid.Row="2" Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding Instances}"
                      SelectedItem="{Binding SelectedInstance}" IsEnabled="{Binding Instances.Count}" />
        </Grid>

        <Border BorderThickness="1" CornerRadius="4" Padding="10" IsVisible="{Binding AcceptsData}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
            <Grid ColumnDefinitions="150,*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="8" ColumnSpacing="8">
                <TextBlock Text="Data file" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Text="{Binding DataFile}" PlaceholderText="CSV or Parquet (instead of an instance)" />
                <Button Grid.Column="2" Content="Browse..." Command="{Binding BrowseDataCommand}" />
                <TextBlock Grid.Row="1" Text="Target column" VerticalAlignment="Center" />
                <ComboBox Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding Columns}" SelectedItem="{Binding Target}" />
                <TextBlock Grid.Row="2" Text="Training %, warm-up" VerticalAlignment="Center" />
                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <TextBox Text="{Binding TrainingPercentText}" Width="70" />
                    <TextBox Text="{Binding TrainingStartText}" Width="70" />
                    <TextBlock Text="first rows train, in file order" VerticalAlignment="Center" Opacity="0.7" />
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock Text="{Binding Error}" Foreground="#C23B4A" TextWrapping="Wrap" IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="Cancel" Click="Cancel" />
            <Button Content="Create" Classes="accent" Click="Create" />
        </StackPanel>
    </StackPanel>
</Window>
